{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UwUSweep",
  "version": "0.1.0-beta.2",
  "identifier": "app.uwusweep.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UwUSweep",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 440,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UwUSweep",
    "homepage": "https://github.com/MinifyX/UwUSweep",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "GPL-3.0-only",
    "license": "GPL-3.0-only",
    "shortDescription": "Uninstall programs and sweep up what they leave behind",
    "longDescription": "Uninstall programs and sweep up what they leave behind: UwUSweep runs a program's own uninstaller, then finds the files, folders and registry entries it left, and moves them into a quarantine you can undo with one click. It can also record an installation, so a later uninstall knows exactly what belongs to it, and turn autostart entries on and off.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/uwusweep.desktop",
        "recommends": ["pkexec | policykit-1"]
      },
      "rpm": {
        "desktopTemplate": "linux/uwusweep.desktop",
        "recommends": ["polkit"]
      }
    }
  }
}
