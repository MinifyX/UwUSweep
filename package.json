{
  "name": "uwusweep",
  "version": "0.1.0-beta.2",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @uwusweep/desktop dev",
    "tauri": "pnpm --filter @uwusweep/desktop tauri",
    "build": "pnpm --filter @uwusweep/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "prettier --check . && node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "build:setup": "node scripts/build-setup.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
